#!/usr/bin/env bash
# secrets-kit -- shim that invokes the bundled CLI via the standalone Python
# that bootstrap installs. The CLI is stdlib-only and adds its own lib/ to
# sys.path, so no venv is needed.
#
# NOTE: `unlock`, `init` and `rotate-identity` prompt for a passphrase on the
# TERMINAL (age does the prompting itself). exec-ing preserves the tty, which
# is what keeps the passphrase out of any transcript -- do not wrap this in
# anything that captures stdio.

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Under claudx (CLAUDE_PLUGIN_TEST) the working copy is the plugin under test, so a
# shim running from the plugin cache would run the INSTALLED release. Refuse it.
# Same scope as bootstrap_lib.env_var_check.cache_root_refusal: only the cache of
# CLAUDE_PLUGIN_TEST_MARKETPLACE is refused (every cache path when it is unset).
if [ -n "${CLAUDE_PLUGIN_TEST:-}" ]; then
    _real_root="$(cd "$PLUGIN_ROOT" && pwd -P | tr '[:upper:]' '[:lower:]')"
    _owned="$(printf '%s' "${CLAUDE_PLUGIN_TEST_MARKETPLACE:-}" | tr '[:upper:]' '[:lower:]')"
    if [ -n "$_owned" ]; then
        _needle="/plugins/cache/${_owned}/"
    else
        _needle="/plugins/cache/"
    fi
    case "${_real_root}/" in
        *"$_needle"*)
            echo "secrets-kit: refusing to run the cached copy at ${PLUGIN_ROOT}: CLAUDE_PLUGIN_TEST is set, so this session tests the working copy and the cached copy is the INSTALLED release. Run the working copy's bin/secrets-kit." >&2
            exit 2
            ;;
    esac
fi
CLI="$PLUGIN_ROOT/scripts/secrets_kit_cli.py"

OS="$(uname -s 2>/dev/null || echo Unknown)"
if [[ "$OS" == MINGW* ]] || [[ "$OS" == MSYS* ]] || [[ "$OS" == CYGWIN* ]]; then
    PY="${HOME}/.local/share/python-standalone/python/python.exe"
else
    PY="${HOME}/.local/share/python-standalone/python/bin/python3"
fi

if [ ! -x "$PY" ] && [ -n "${BOOTSTRAP_PYTHON:-}" ] && [ -x "$BOOTSTRAP_PYTHON" ]; then
    case "$(cd "$(dirname "$BOOTSTRAP_PYTHON")" 2>/dev/null && pwd -P)" in
        "$(cd "${HOME}/.local/share/python-standalone" 2>/dev/null && pwd -P)"/*) PY="$BOOTSTRAP_PYTHON" ;;
    esac
fi

if [ ! -x "$PY" ]; then
    # Fall back to anything on PATH; bootstrap normally guarantees the
    # standalone interpreter, but degrade gracefully if it is missing.
    if command -v python3 >/dev/null 2>&1; then
        PY="python3"
    elif command -v python >/dev/null 2>&1; then
        PY="python"
    else
        echo "secrets-kit: no Python interpreter found" >&2
        exit 1
    fi
fi

exec "$PY" "$CLI" "$@"
