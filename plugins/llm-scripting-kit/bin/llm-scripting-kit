#!/usr/bin/env bash
# llm-scripting-kit -- shim that invokes the bundled CLI.
#
# Interpreter preference:
#   1. the plugin venv bootstrap provisions -- it has PyYAML, which the CLI
#      needs to read the layered config.yaml (bootstrap_lib.config_resolve).
#   2. the standalone Python bootstrap installs -- no third-party packages, so
#      the CLI degrades to the shipped model baseline (it warns and continues).
#   3. anything on PATH.
# The CLI adds its own lib/ to sys.path, so no interpreter needs it installed.

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Under claudx (CLAUDE_PLUGIN_TEST) the working copy is the plugin under test, so a
# shim running from the plugin cache would run the INSTALLED release. Refuse it.
# Same scope as bootstrap_lib.env_var_check.cache_root_refusal: only the cache of
# CLAUDE_PLUGIN_TEST_MARKETPLACE is refused (every cache path when it is unset).
if [ -n "${CLAUDE_PLUGIN_TEST:-}" ]; then
    _real_root="$(cd "$PLUGIN_ROOT" && pwd -P | tr '[:upper:]' '[:lower:]')"
    _owned="$(printf '%s' "${CLAUDE_PLUGIN_TEST_MARKETPLACE:-}" | tr '[:upper:]' '[:lower:]')"
    if [ -n "$_owned" ]; then
        _needle="/plugins/cache/${_owned}/"
    else
        _needle="/plugins/cache/"
    fi
    case "${_real_root}/" in
        *"$_needle"*)
            echo "llm-scripting-kit: refusing to run the cached copy at ${PLUGIN_ROOT}: CLAUDE_PLUGIN_TEST is set, so this session tests the working copy and the cached copy is the INSTALLED release. Run the working copy's bin/llm-scripting-kit." >&2
            exit 2
            ;;
    esac
fi
CLI="$PLUGIN_ROOT/scripts/llm_scripting_kit_cli.py"
DATA_DIR="${HOME}/.claude/plugins/data/plugins-kit/llm-scripting-kit"

OS="$(uname -s 2>/dev/null || echo Unknown)"
if [[ "$OS" == MINGW* ]] || [[ "$OS" == MSYS* ]] || [[ "$OS" == CYGWIN* ]]; then
    VENV_REL=".venv/Scripts/python.exe"
    STANDALONE_PY="${HOME}/.local/share/python-standalone/python/python.exe"
else
    VENV_REL=".venv/bin/python"
    STANDALONE_PY="${HOME}/.local/share/python-standalone/python/bin/python3"
fi
VENV_PY="${DATA_DIR}/${VENV_REL}"
# CLAUDE_BOOTSTRAP_DATA_ROOT is set only for a session that redirects bootstrap's
# data tree (scripts/claude_plugin_test.py). When it is set, this plugin's venv is
# the one under that tree and nothing else: a missing redirected venv exits 2
# rather than falling back to the production venv, which holds the published
# release and would run it inside a session meant to test the working copy.
# When it is unset the chain below is unchanged.
if [ -n "${CLAUDE_BOOTSTRAP_DATA_ROOT:-}" ]; then
    VENV_PY="${CLAUDE_BOOTSTRAP_DATA_ROOT}/plugins-kit/llm-scripting-kit/${VENV_REL}"
    if [ ! -x "$VENV_PY" ]; then
        echo "llm-scripting-kit: CLAUDE_BOOTSTRAP_DATA_ROOT redirects bootstrap's data tree, but the redirected plugin interpreter is missing at ${VENV_PY}; refusing to fall back to the production venv." >&2
        exit 2
    fi
fi

if [ -x "$VENV_PY" ]; then
    PY="$VENV_PY"
elif [ -x "$STANDALONE_PY" ]; then
    PY="$STANDALONE_PY"
else
    PY=""
    if [ -n "${BOOTSTRAP_PYTHON:-}" ] && [ -x "$BOOTSTRAP_PYTHON" ]; then
        case "$(cd "$(dirname "$BOOTSTRAP_PYTHON")" 2>/dev/null && pwd -P)" in
            "$(cd "${HOME}/.local/share/python-standalone" 2>/dev/null && pwd -P)"/*) PY="$BOOTSTRAP_PYTHON" ;;
        esac
    fi
    if [ -z "$PY" ]; then
        if command -v python3 >/dev/null 2>&1; then
            PY="python3"
        elif command -v python >/dev/null 2>&1; then
            PY="python"
        else
            echo "llm-scripting-kit: no Python interpreter found" >&2
            exit 1
        fi
    fi
fi

exec "$PY" "$CLI" "$@"
